            {
              "text": "醫事答問"
            },
            {
              "text": "奧州　桃井安貞著述"
            },
            {
              "text": "安貞問古醫事於東洞先生蓋扁鵲仲"
            },
            {
              "text": "景之醫事周漢以降唐宋元明二千餘歳"
            },
            {
              "text": "雖英雄豪傑滿於天下未聞為秦張之醫"
            },
            {
              "text": "事者雖千金外臺以下之方書多於後世"
            },
            {
              "text": "無通金匱傷寒論者至于今先生始通其"
            },
            {
              "text": "書以古之方與今之病者屢有驗萬病無"
            },
            {
              "text": "不愈其先生何以知此法乎先生"
            }
          ],
